    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);",
                  "if (json.user && json.user.username) pm.collectionVariables.set('username', json.user.username);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student_{{timestamp}}\",\n  \"password\": \"StrongPassword123\",\n  \"email\": \"student@example.com\",\n  \"first_name\": \"Nikita\",\n  \"last_name\": \"Chervov\"\n}"
