{
  "info": {
    "name": "Social Course API",
    "description": "Postman collection для Django REST API курсового проекта «Социальная сеть». Коллекция использует переменные окружения и автоматически сохраняет token, post_id, comment_id, conversation_id и notification_id из ответов.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "Authorization",
        "type": "string"
      },
      {
        "key": "value",
        "value": "Token {{token}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set('timestamp', Date.now());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "username",
      "value": "alice"
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "target_username",
      "value": "bob"
    },
    {
      "key": "post_id",
      "value": "1"
    },
    {
      "key": "comment_id",
      "value": "1"
    },
    {
      "key": "conversation_id",
      "value": "1"
    },
    {
      "key": "notification_id",
      "value": "1"
    },
    {
      "key": "tag_slug",
      "value": "django"
    }
  ],
